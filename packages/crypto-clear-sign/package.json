{
  "name": "@hzblj/crypto-clear-sign",
  "version": "0.1.2",
  "description": "Clear signing as data: the chain-agnostic display model a wallet shows before it signs (an intent, ordered fields, nested actions, warnings with stable codes and a risk level, how it was understood, and what was left raw), with exact amount formatting, localizable text, resolver interfaces for tokens, names and descriptors, and a plain text rendering. Pure TypeScript with no dependencies.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/crypto-clear-sign.git",
    "directory": "packages/crypto-clear-sign"
  },
  "bugs": {
    "url": "https://github.com/hzblj/crypto-clear-sign/issues"
  },
  "homepage": "https://github.com/hzblj/crypto-clear-sign/tree/main/packages/crypto-clear-sign#readme",
  "keywords": [
    "blind-signing",
    "clear-signing",
    "erc-7730",
    "hardware-wallet",
    "react-native",
    "risk",
    "security",
    "transaction-preview",
    "wallet"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
