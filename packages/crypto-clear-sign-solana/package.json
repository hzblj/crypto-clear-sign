{
  "name": "@hzblj/crypto-clear-sign-solana",
  "version": "0.0.0",
  "description": "Solana clear signing for @hzblj/crypto-clear-sign: legacy and v0 transactions, messages and off-chain messages, read through the chain client of @hzblj/crypto-solana into the shared display model, with IDLs from a resolver. No UI.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/crypto-clear-sign.git",
    "directory": "packages/crypto-clear-sign-solana"
  },
  "bugs": {
    "url": "https://github.com/hzblj/crypto-clear-sign/issues"
  },
  "homepage": "https://github.com/hzblj/crypto-clear-sign/tree/main/packages/crypto-clear-sign-solana#readme",
  "keywords": [
    "blind-signing",
    "clear-signing",
    "hardware-wallet",
    "idl",
    "react-native",
    "solana",
    "spl-token",
    "wallet"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@hzblj/crypto-clear-sign": "workspace:^",
    "@hzblj/crypto-solana": "^0.3.0"
  },
  "peerDependencies": {
    "@hzblj/nitro-crypto": "^0.1.5"
  },
  "devDependencies": {
    "@hzblj/nitro-crypto": "^0.1.5",
    "@solana-program/address-lookup-table": "0.16.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/loader-v3": "0.8.0",
    "@solana-program/memo": "0.16.0",
    "@solana-program/stake": "0.11.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana-program/token-2022": "0.20.0",
    "@solana/kit": "8.5.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
