{
  "name": "@hzblj/crypto-clear-sign-ethereum",
  "version": "0.2.0",
  "description": "Ethereum and EVM clear signing for @hzblj/crypto-clear-sign: transactions of every type, EIP-712 typed data, EIP-191 messages with Sign-In with Ethereum, and EIP-7702 authorizations, read through the chain client of @hzblj/crypto-ethereum into the shared display model, with built-in decoders for the standard calls and ERC-7730 descriptors rendered by @ethereum-sourcify/clear-signing (and a bundled set of registry descriptors). No UI.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/crypto-clear-sign.git",
    "directory": "packages/crypto-clear-sign-ethereum"
  },
  "bugs": {
    "url": "https://github.com/hzblj/crypto-clear-sign/issues"
  },
  "homepage": "https://github.com/hzblj/crypto-clear-sign/tree/main/packages/crypto-clear-sign-ethereum#readme",
  "keywords": [
    "blind-signing",
    "clear-signing",
    "eip-712",
    "eip-7702",
    "erc-20",
    "erc-7730",
    "ethereum",
    "evm",
    "hardware-wallet",
    "react-native",
    "wallet"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./registry": {
      "source": "./src/registry/index.ts",
      "types": "./build/registry/index.d.ts",
      "default": "./build/registry/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p ./tsconfig.build.json",
    "clean": "rm -rf build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "tsc -p ./tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@ethereum-sourcify/clear-signing": "^0.3.0",
    "@hzblj/crypto-clear-sign": "workspace:^",
    "@hzblj/crypto-ethereum": "^0.3.0",
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "@hzblj/nitro-crypto": "^0.1.5"
  },
  "devDependencies": {
    "@hzblj/nitro-crypto": "^0.1.5",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "viem": "2.57.11"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./registry": {
        "types": "./build/registry/index.d.ts",
        "default": "./build/registry/index.js"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
